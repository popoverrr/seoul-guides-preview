---
// The authors' seal (도장): vermilion square, their names in hangul. Used at the authors' section and in
// the footer only — the one place --seal appears.
interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: cls = '' } = Astro.props;
---

<span class:list={['seal', cls]} style={`--size:${size}px`} role="img" aria-label="Печать авторов: Айдана и София">
  <span lang="ko" aria-hidden="true">아이다나<br />소피아</span>
</span>

<style>
  .seal {
    display: inline-grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    padding: 4px;
    border: 2px solid var(--seal);
    border-radius: 50%;
    color: var(--seal);
    transform: rotate(-4deg);
    font-family: var(--f-ko);
    font-weight: 400;
    font-size: calc(var(--size) * 0.2);
    line-height: 1.05;
    text-align: center;
    word-break: keep-all;
  }
</style>
