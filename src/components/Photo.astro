---
// Photo slot (docs/02 § 8). Looks for src/assets/photos/{client,site,temp}/<slot>.(jpg|jpeg|png|webp|avif):
// client photos win, then site photos (generated for the site, permanent — D-032), then temporary ones.
// <slot>-wide, if present, is the desktop crop (≥1024px) via <picture><source media>. No file → a tonal plate.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slot: string;
  /** CSS aspect-ratio, e.g. "4 / 5" */
  ratio: string;
  /** different crop on desktop (≥1024), e.g. "16 / 9" */
  ratioDesktop?: string;
  alt: string;
  /** what should be in the frame — shown on the plate */
  brief?: string;
  tone?: 'day' | 'dark';
  eager?: boolean;
  sizes?: string;
  class?: string;
  fill?: boolean;
  /** eager image that is not the LCP: load early but do not outrank fonts */
  lowPriority?: boolean;
  /** put the plate label at the top (frames with text over the bottom) */
  labelTop?: boolean;
}

const {
  slot,
  ratio,
  ratioDesktop,
  alt,
  brief = '',
  tone = 'day',
  eager = false,
  sizes = '100vw',
  class: cls = '',
  fill = false,
  labelTop = false,
  lowPriority = false,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/{client,site,temp}/*.{jpg,jpeg,png,webp,avif}');
const rank = (p: string) => (p.includes('/client/') ? 0 : p.includes('/site/') ? 1 : 2);
const find = async (name: string) => {
  const key = Object.keys(files)
    .filter((p) => p.replace(/^.*\//, '').replace(/\.\w+$/, '') === name)
    .sort((a, b) => rank(a) - rank(b))[0];
  return key ? { key, img: (await files[key]!()).default } : null;
};
const main = await find(slot);
const wide = main ? await find(`${slot}-wide`) : null;
const isTemp = main?.key.includes('/temp/') ?? false;

const WIDTHS = [360, 540, 720, 840, 1080, 1440, 2160];
async function srcset(img: ImageMetadata, format: 'avif' | 'webp') {
  const ws = WIDTHS.filter((w) => w <= img.width);
  const out = await Promise.all(ws.map((w) => getImage({ src: img, width: w, format, quality: format === 'avif' ? 64 : 80 })));
  return out.map((o, i) => `${o.src} ${ws[i]}w`).join(', ');
}
const pic = main
  ? {
      avif: await srcset(main.img, 'avif'),
      webp: await srcset(main.img, 'webp'),
      wideAvif: wide ? await srcset(wide.img, 'avif') : '',
      wideWebp: wide ? await srcset(wide.img, 'webp') : '',
      fallback: (await getImage({ src: main.img, width: Math.min(1080, main.img.width), format: 'jpeg', quality: 80 })).src,
    }
  : null;
---

<div
  class:list={['photo', `photo--${tone}`, { 'photo--fill': fill, 'photo--plate': !main }, cls]}
  style={`--ratio:${ratio};--ratio-d:${ratioDesktop ?? ratio}`}
  data-slot={slot}
>
  {
    main && pic ? (
      <picture>
        {wide && <source media="(min-width: 1024px)" type="image/avif" srcset={pic.wideAvif} sizes={sizes} />}
        {wide && <source media="(min-width: 1024px)" type="image/webp" srcset={pic.wideWebp} sizes={sizes} />}
        <source type="image/avif" srcset={pic.avif} sizes={sizes} />
        <source type="image/webp" srcset={pic.webp} sizes={sizes} />
        <img
          src={pic.fallback}
          alt={alt}
          width={main.img.width}
          height={main.img.height}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager && !lowPriority ? 'high' : 'auto'}
          decoding="async"
        />
      </picture>
    ) : (
      <div class:list={['plate', { 'plate--top': labelTop }]} role="img" aria-label={alt}>
        <span class="plate__label t-label">Фото · {slot}</span>
        {brief && <span class="plate__brief">{brief}</span>}
      </div>
    )
  }
  {isTemp && import.meta.env.DEV && <span class="temp t-label">TEMP</span>}
</div>

<style>
  .photo {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--r-l);
    background: var(--cream-2);
  }

  .photo--fill {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
  }

  @media (min-width: 1024px) {
    .photo {
      aspect-ratio: var(--ratio-d);
    }

    .photo--fill {
      aspect-ratio: auto;
    }
  }

  .photo picture {
    display: contents;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-filter);
  }

  .photo--dark {
    background: #2a2824;
  }

  /* placeholder plate: crop marks + slot name, reads as a layout dummy, not as a design element */
  .plate {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 20px;
    color: var(--ink-2);
  }

  .plate--top {
    justify-content: flex-start;
    padding-top: calc(var(--bar-h) + 40px + env(safe-area-inset-top));
  }

  .plate::before,
  .plate::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid currentcolor;
    opacity: 0.6;
  }

  .plate::before {
    top: 14px;
    left: 14px;
    border-width: 1px 0 0 1px;
  }

  .plate::after {
    top: 14px;
    right: 14px;
    border-width: 1px 1px 0 0;
  }

  .photo--dark .plate {
    color: var(--night-mute);
  }

  .plate__brief {
    max-width: 26em;
    font-size: var(--t-caption);
    line-height: 1.4;
  }

  .temp {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 6px;
    background: var(--ink);
    color: var(--cream);
  }
</style>
