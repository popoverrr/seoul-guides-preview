---
// «Моя подборка» bar at the bottom of every page (motion/pick.ts shows it once a guide is picked).
// The ink capsule of the night chapter, so it reads above any section; the green button is the only action.
import guides from '../data/guides.json';

const titles = Object.fromEntries(guides.map((g) => [g.slug, g.title_ru]));
---

<script type="application/json" data-pick-titles set:html={JSON.stringify(titles)} />

<div class="dock" data-pick-dock role="region" aria-label="Моя подборка">
  <a class="dock__sum" href="/pick/">
    <b data-pick-label>0 гайдов</b>
    <span>моя подборка</span>
  </a>
  <a class="dock__wa" href="#contacts" data-pick-wa data-lead="guide" data-lead-slug="pick">Написать в WhatsApp</a>
</div>

<style>
  .dock {
    position: fixed;
    inset: auto 12px calc(12px + env(safe-area-inset-bottom));
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 560px;
    margin-inline: auto;
    padding: 6px 6px 6px 18px;
    border-radius: var(--r-pill);
    background: #121210;
    color: #f4efe6;
    box-shadow: 0 10px 30px rgb(18 18 16 / 0.28); /* stylelint-disable-line declaration-property-value-disallowed-list -- the bar floats over the page */
    transform: translateY(140%);
    visibility: hidden;
    transition:
      transform var(--d-base) var(--ease-tea),
      visibility 0s linear var(--d-base);
  }

  .dock[data-on] {
    transform: none;
    visibility: visible;
    transition:
      transform var(--d-base) var(--ease-tea),
      visibility 0s;
  }

  .dock__sum {
    display: grid;
    margin-right: auto;
    min-height: 44px;
    align-content: center;
    line-height: 1.15;
  }

  .dock__sum b {
    font-weight: 500;
  }

  .dock__sum span {
    font-size: 0.75rem;
    color: #a39c90;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dock__wa {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    background: var(--green);
    color: var(--green-ink);
    font-weight: 500;
    white-space: nowrap;
  }

  .dock__wa:active {
    transform: scale(0.98);
  }

  @media (prefers-reduced-motion: reduce) {
    .dock,
    .dock[data-on] {
      transition: none;
    }
  }
</style>
