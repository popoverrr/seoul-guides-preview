---
// Bojagi mosaic (docs/02 § 7, docs/12 § 3): photo patches of different size, 1px seams = grid gap over --line,
// white Hahmlet emblem, 10×10 patch-colour label; names and prices go in the legend below, not over photos.
// Layout adapts to the number of guides (5 or 6). Seoul Food is always the largest patch.
import guides from '../data/guides.json';
import Photo from './Photo.astro';
import { localeFrom, t } from '../lib/i18n';

const locale = localeFrom(Astro.url);
const base = locale === 'en' ? '/en' : '';
const count = guides.length;
const briefs: Record<string, string> = {
  'seoul-food': 'интерьер ресторана или кафе, стол - не крупный план еды',
  'shopping-women': 'концепт-стор, витрина, ткань',
  'shopping-men': 'мастерская, магазин, материалы',
  culture: 'галерея, мастер-класс, ханок',
  kids: 'парк, музей, пространство для детей',
  beauty: 'интерьер салона, косметика в свете',
};
---

<figure class="bojagi" data-count={count} data-bojagi>
  <ul class="bojagi__grid" role="list">
    {
      guides.map((g, i) => (
        <li class={`bojagi__patch p${i + 1}`} style={`--patch:var(${g.patch})`}>
          <a href={`${base}/guides/${g.slug}/`} data-cursor={t(locale, 'open')}>
            <span class="visually-hidden">{locale === 'en' ? g.title_en : g.aria_ru}</span>
            <div class="bojagi__img" transition:name={`guide-photo-${g.slug}`}>
            <Photo
              slot={`guide-${g.slug}`}
              ratio="auto"
              alt=""
              fill
              brief={briefs[g.slug] ?? ''}
              sizes="(min-width: 1024px) 40vw, 66vw"
            />
            </div>
            <span class="bojagi__emblem t-emblem" lang="ko" aria-hidden="true" transition:name={`guide-emblem-${g.slug}`}>
              {g.emblem}
            </span>
            <span class="bojagi__n t-roman" aria-hidden="true">
              {i + 1}
            </span>
            <span class="bojagi__tag" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
  <figcaption class="bojagi__legend t-caption">
    {
      guides.map((g, i) => (
        <span>
          <b>{i + 1}</b> {locale === 'en' ? g.title_en : g.title_ru}
        </span>
      ))
    }
  </figcaption>
</figure>

<style>
  .bojagi__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 56px;
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
  }

  /* 6 guides */
  .p1 { grid-column: 1 / 5; grid-row: 1 / 7; }
  .p2 { grid-column: 5 / 7; grid-row: 1 / 4; }
  .p3 { grid-column: 5 / 7; grid-row: 4 / 7; }
  .p4 { grid-column: 1 / 4; grid-row: 7 / 11; }
  .p5 { grid-column: 4 / 7; grid-row: 7 / 9; }
  .p6 { grid-column: 4 / 7; grid-row: 9 / 11; }

  /* 5 guides: the last one takes the whole lower right */
  [data-count='5'] .p5 { grid-row: 7 / 11; }

  .bojagi__img {
    position: absolute;
    inset: 0;
  }

  .bojagi__patch {
    position: relative;
    overflow: hidden;
    background: var(--cream-2);
  }

  .bojagi__patch a {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--on-photo);
    transition: transform 240ms var(--ease-tea);
  }

  .bojagi__patch a:active {
    transform: scale(0.985);
    transition-duration: 120ms;
  }

  /* emblem sits in the photo; on the plate (no photo yet) it is ink */
  .bojagi__emblem {
    position: absolute;
    right: 12px;
    bottom: 6px;
    font-size: clamp(2.25rem, 9vw, 4.5rem);
    color: var(--on-photo);
  }

  .bojagi__patch:has(.photo--plate) .bojagi__emblem,
  .bojagi__patch:has(.photo--plate) .bojagi__n {
    color: var(--ink);
  }

  .p1 .bojagi__emblem {
    font-size: clamp(4rem, 22vw, 8rem);
  }

  .bojagi__n {
    position: absolute;
    top: 10px;
    right: 12px;
    color: var(--on-photo);
  }

  .bojagi__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 10px;
    height: 10px;
    background: var(--patch);
  }

  /* plate brief is too long for small patches */
  .bojagi__patch :global(.plate__brief) {
    display: none;
  }

  .bojagi__patch:not(.p1) :global(.plate__label) {
    display: none;
  }

  .p1 :global(.plate__brief) {
    display: block;
    max-width: 60%;
  }

  .bojagi__patch :global(.plate) {
    padding: 12px;
    justify-content: flex-end;
  }

  .bojagi__patch :global(.plate::before),
  .bojagi__patch :global(.plate::after) {
    display: none;
  }

  .bojagi__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 12px;
  }

  .bojagi__legend b {
    font-weight: 600;
    color: var(--ink-2);
  }

  @media (min-width: 1024px) {
    .bojagi__grid {
      grid-auto-rows: 64px;
    }
  }
</style>
