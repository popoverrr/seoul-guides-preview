---
// Free part «Перед поездкой» (docs/01 § 5 I, content-audit/01 § 3: pages 3-11 of the general PDF)
// in the «Флагман + тетрадь» world: chips for the contents, one paper card per topic.
// Facts here come from the source; the authors' full texts arrive with P7 (import of pages 3-11).
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Photo from '../../components/Photo.astro';
import Note from '../../components/Note.astro';
import LinkArrow from '../../components/LinkArrow.astro';
import Footer from '../../components/Footer.astro';
import c from '../../content/fixtures/public.ru.json';
import { nb } from '../../lib/typo';

const body: Record<string, { page: string; tiles?: [string, string][]; kind?: 'numbers' | 'apps' }> = {
  letter: { page: 'стр. 3-4' },
  etiquette: { page: 'стр. 6-7' },
  documents: { page: 'стр. 9' },
  money: { page: 'стр. 9' },
  connection: { page: 'стр. 10' },
  safety: {
    page: 'стр. 10',
    kind: 'numbers',
    tiles: [
      ['119', 'пожарные и скорая'],
      ['112', 'полиция'],
      ['1330', 'туристическая линия'],
    ],
  },
  apps: {
    page: 'стр. 11',
    kind: 'apps',
    tiles: [
      ['NAVER Map', 'карты и адреса'],
      ['KakaoTalk', 'мессенджер'],
      ['Kakao T', 'такси'],
      ['Uber', 'такси'],
      ['Catch Table', 'бронь ресторанов'],
    ],
  },
};
---

<Base title="Перед поездкой" description={c.prepare.lead}>
  <TopBar />
  <main id="main" class="prep">
    <header class="prep__head wrap">
      <h1 class="t-display prep__title">{c.prepare.title}</h1>
      <p class="t-lead prep__lead">{nb(c.prepare.lead)}</p>
      <Note mark="underline" rotate={-3} instant>бесплатно, без регистрации</Note>
    </header>

    <div class="wrap prep__frame">
      <Photo slot="prepare" ratio="4 / 5" ratioDesktop="21 / 9" alt="Кофе у окна с видом на ханок" eager sizes="(min-width: 1024px) 1260px, 92vw" />
    </div>

    <nav class="chips" aria-label="Темы">
      <ul role="list">
        {
          c.prepare.topics.map((tp) => (
            <li>
              <a href={`#${tp.id}`}>{nb(tp.title.replace(/:.*$/, ''))}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="wrap cards">
      {
        c.prepare.topics.map((tp) => {
          const b = body[tp.id];
          return (
            <section class="card" id={tp.id} aria-labelledby={`h-${tp.id}`}>
              <h2 class="t-name" id={`h-${tp.id}`}>
                {nb(tp.title)}
              </h2>
              {b?.tiles && (
                <ul class:list={['tiles', `tiles--${b.kind}`]} role="list">
                  {b.tiles.map(([k, v]) => (
                    <li>
                      <span class="tiles__k t-num">{k}</span>
                      <span class="tiles__v">{v}</span>
                    </li>
                  ))}
                </ul>
              )}
              <p class="card__todo">[текст авторов - общий гайд, {b?.page}]</p>
            </section>
          );
        })
      }
    </div>

    <div class="wrap prep__next">
      <LinkArrow href="/#guides">Выбрать гайд</LinkArrow>
    </div>
  </main>
  <Footer note={c.footer.note} legal={c.footer.legal} />
</Base>

<style>
  .prep__head {
    display: grid;
    gap: 16px;
    padding-top: calc(var(--bar-h) + 40px);
  }

  .prep__title {
    max-width: 9ch;
  }

  .prep__frame {
    margin-top: 28px;
  }

  /* contents as a row of round chips */
  .chips {
    position: sticky;
    top: var(--bar-h);
    z-index: 5;
    margin-top: 20px;
    padding: 10px 0;
    background: var(--plaster);
  }

  .chips ul {
    display: flex;
    gap: 8px;
    padding: 0 var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .chips a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .chips a:active {
    background: var(--ink);
    color: var(--paper);
  }

  /* one paper card per topic */
  .cards {
    display: grid;
    gap: 10px;
    margin-top: 12px;
  }

  .card {
    display: grid;
    gap: 14px;
    padding: 22px 20px;
    background: var(--paper);
    border-radius: var(--r-l);
    scroll-margin-top: calc(var(--bar-h) + 70px);
  }

  .card__todo {
    font-size: var(--s-small);
    color: var(--ink-2);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .tiles li {
    display: grid;
    gap: 4px;
    padding: 14px 12px;
    background: var(--plaster);
    border-radius: var(--r-m);
  }

  .tiles__k {
    font-family: var(--f-display);
    font-size: 1.75rem;
    line-height: 1;
  }

  .tiles__v {
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .tiles--apps {
    grid-template-columns: 1fr 1fr;
  }

  .tiles--apps .tiles__k {
    font-size: 1.25rem;
  }

  .tiles--numbers li {
    background: #16150f;
    color: #f4efe6;
  }

  .tiles--numbers .tiles__k {
    color: #ffb547;
  }

  .tiles--numbers .tiles__v {
    color: #c9c1b4;
  }

  .prep__next {
    padding-block: 40px 56px;
  }

  @media (min-width: 1024px) {
    .chips ul {
      max-width: var(--max);
      margin: 0 auto;
      padding-inline: var(--gutter);
    }

    .cards {
      grid-template-columns: 1fr 1fr;
    }

    .tiles--apps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
