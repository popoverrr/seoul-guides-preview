---
// Home - «Флагман + тетрадь» (.impeccable/surfaces/web-src-pages-index-astro.md, D-034).
// A Seoul flagship store of six guides on plinths, annotated by the authors' own hand.
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import Note from '../components/Note.astro';
import GuideGrid from '../components/GuideGrid.astro';
import LinkArrow from '../components/LinkArrow.astro';
import ButtonPrimary from '../components/ButtonPrimary.astro';
import InkMap from '../components/InkMap.astro';
import PlacePreview from '../components/PlacePreview.astro';
import Seal from '../components/Seal.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import MediaCarousel from '../components/MediaCarousel.astro';
import guides from '../data/guides.json';
import c from '../content/fixtures/public.ru.json';
import { nb } from '../lib/typo';
import { SLOGAN } from '../lib/brand';

const chapters = [
  { id: 'about', title: 'О нас' },
  { id: 'guides', title: 'Гайды' },
  { id: 'inside', title: 'Как устроен гайд' },
  { id: 'night', title: 'Сеул после девяти' },
  { id: 'tour', title: 'Тур Christmas Glow' },
  { id: 'media', title: 'Видео с поездок' },
  { id: 'prepare', title: 'Перед поездкой' },
  { id: 'authors', title: 'The Founders' },
  { id: 'buy', title: 'Как купить' },
];
// the client's clips (28.10); the ad reel joins the row when she sends it
const clips = [
  { file: 'trips', title: 'С наших поездок', text: 'Сборное видео из всех поездок' },
  { file: 'food', title: 'Гастро-тур', text: 'О еде: что вас ждёт', sound: true },
  { file: 'xmas-1', title: 'Рождественский Сеул', text: 'Атмосфера тура Christmas Glow', sound: true },
  { file: 'xmas-2', title: 'Рождество в деталях', text: 'Ёлки, банты и десерты', sound: true },
];
// the client's own Seoul (29.10: «использовать где-то на сайте, где актуально»)
const seoul = [
  ['seoul-gyeongbokgung', 'Кёнбоккун через проём ворот'],
  ['seoul-hanok-window', 'Решётчатое окно ханока'],
  ['seoul-hanok-evening', 'Галерея ханока вечером'],
  ['seoul-namsan-terrace', 'Бетонная терраса с видом на Намсан'],
  ['seoul-records', 'Магазин пластинок'],
  ['seoul-posters', 'Стена с афишами и велосипед'],
  ['seoul-han-window', 'Река Хан в окне'],
  ['seoul-train', 'Поезд на мосту через Хан'],
  ['seoul-bridge', 'Велодорожка под мостом'],
  ['seoul-poster-tower', 'Постер с башней в витрине'],
  ['seoul-poster', 'Постер SEOUL на стене'],
  ['seoul-rain-night', 'Улица после дождя ночью'],
] as const;
const bySlug = Object.fromEntries(guides.map((g) => [g.slug, g]));
const included = [
  'отель и завтраки',
  'трансферы и такси на весь день',
  'мастер-класс по макияжу и ужин в ханоке',
  'омакасэ из премиальной говядины и чайная омакасэ',
  'шоу Touch Five и вечер в клубе',
  'шопинг со стилистом и бьюти-специалистом',
];
---

<Base cover description={c.cover.lead}>
  <a class="skip" href="#main">К содержанию</a>
  <TopBar chapters={chapters} />

  <main id="main">
    <!-- first viewport: the photo, the slogan, one sentence, the action and the authors' hand -->
    <section class="cover" data-cover-section data-chapter="" aria-labelledby="cover-title">
      <div class="cover__media" data-cover-media>
        <Photo slot="cover" ratio="9 / 16" ratioDesktop="16 / 9" alt={c.cover.caption} tone="dark" fill eager lowPriority />
      </div>
      <div class="cover__scrim" aria-hidden="true"></div>
      <div class="cover__text wrap" data-cover-text>
        <h1 class="cover__title t-head" id="cover-title">{nb(SLOGAN)}</h1>
        <p class="cover__lead">{nb(c.cover.lead)}</p>
        <!-- the six guides on the first screen: tap goes straight into a guide -->
        <ul class="pebbles" role="list" aria-label="Гайды">
          {
            guides.map((g) => (
              <li>
                <a class:list={['pebble', { 'pebble--soon': !g.ready }]} href={`/guides/${g.slug}/`} style={`--patch:var(${g.patch})`}>
                  <span class="pebble__ko" lang="ko" aria-hidden="true">
                    {g.emblem}
                  </span>
                  <span>{g.short_ru}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="cover__act">
          <a class="cover__go" href="#guides">Подобрать гайд ↓</a>
          <a class="cover__free" href="/prepare/">Бесплатно: перед поездкой</a>
        </div>
      </div>
    </section>

    <!-- the client's own words about the project (28.10), verbatim -->
    <section class="sec wrap about" id="about" data-chapter="about" aria-labelledby="h-about">
      <h2 class="t-head about__title" id="h-about">{c.about.title}</h2>
      <p class="t-lead about__lead">{nb(c.about.lead)}</p>
      <div class="about__text">
        {c.about.paragraphs.map((p) => <p>{nb(p)}</p>)}
      </div>
      <Note rotate={-2} class="about__hand">{c.about.closing}</Note>
      <ul class="strip" role="list" aria-label="Сеул на наших фото">
        {
          seoul.map(([slot, alt]) => (
            <li>
              <Photo slot={slot} ratio="3 / 4" alt={alt} sizes="(min-width: 1024px) 240px, 52vw" />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- the store: six guides on plinths -->
    <section class="sec wrap" id="guides" data-chapter="guides" aria-labelledby="h-guides">
      <SectionHead id="h-guides" title={c.guides.title} lead={c.guides.lead}>
        <Note slot="note" mark="arrow-down" rotate={-3}>«+» - в подборку, купить можно сразу несколько</Note>
      </SectionHead>
      <div class="sec__body">
        <GuideGrid />
      </div>
    </section>

    <!-- one opened guide page -->
    <section class="sec sec--tone" id="inside" data-chapter="inside" aria-labelledby="h-inside">
      <div class="wrap inside">
        <SectionHead id="h-inside" title={c.inside.title} lead={c.inside.lead} />
        <div class="inside__card">
          <PlacePreview place={c.inside.place} note={c.inside.naver_note} hand={c.inside.note} />
        </div>
      </div>
    </section>

    <!-- night: dark field, neon tubes in amber and teal (owner 27.10) - light, not fake hangul signage (client brief) -->
    <section class="night tone-night" id="night" data-chapter="night" data-night-chapter aria-labelledby="h-night">
      <div class="night__frame" data-frame>
        <Photo slot="night" ratio="4 / 5" ratioDesktop="16 / 9" alt="Вечер в баре, ночной Сеул" tone="dark" sizes="100vw" />
        <div class="night__over wrap">
          <h2 class="night__title" id="h-night">
            <span class="night__seoul t-head">Сеул</span>
            <span class="neon" data-neon data-text="после девяти">после девяти</span>
          </h2>
          <svg class="tube" viewBox="0 0 320 40" preserveAspectRatio="none" aria-hidden="true" data-neon>
            <path class="tube__glow" d="M4 30 C 60 6, 110 38, 160 20 S 260 4, 316 22" pathLength="1" />
            <path class="tube__core" d="M4 30 C 60 6, 110 38, 160 20 S 260 4, 316 22" pathLength="1" />
          </svg>
          <p class="night__clock" data-seoul-clock hidden>
            В Сеуле сейчас <b class="t-num" data-seoul-time></b><span data-seoul-night hidden> - самое время для этой главы</span>
          </p>
        </div>
      </div>
      <div class="wrap night__body">
        <p class="t-lead night__lead" data-reveal="fade">{nb(c.night.lead)}</p>
        <span class="rail" aria-hidden="true"><i></i></span>
        <ul class="night__list" role="list" data-neon>
          {
            c.night.items.map((it, i) => (
              <li style={`--i:${i}`}>
                <a href={`/guides/${it.guide}/`}>
                  <span class="t-emblem night__emblem" lang="ko" aria-hidden="true">
                    {bySlug[it.guide]?.emblem}
                  </span>
                  <span>
                    <span class="t-name">{it.title}</span>
                    <span class="night__text">{nb(it.text)}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- the tour as a limited edition on its own plinth -->
    <section class="sec wrap tour" id="tour" data-chapter="tour" aria-labelledby="h-tour">
      <div class="tour__print" data-frame>
        <Photo slot="tour-cover" ratio="4 / 5" alt="Ёлка в лобби отеля, Сеул" sizes="(min-width: 1024px) 50vw, 100vw" />
      </div>
      <div class="tour__label">
        <p class="tour__kicker">{c.tour.kicker}</p>
        <h2 class="t-head tour__title" id="h-tour">{c.tour.title}</h2>
        <p class="tour__sub">{c.tour.subtitle}</p>
        <dl class="tour__rows">
          <div><dt>Когда</dt><dd>{c.tour.season}</dd></div>
          <div><dt>Состав</dt><dd>{included.join(', ')}</dd></div>
          <div><dt>Стоимость</dt><dd class="t-num">{nb(c.tour.price)}</dd></div>
        </dl>
        <LinkArrow href="/tours/christmas-glow/">Программа и заявка</LinkArrow>
      </div>
    </section>

    <!-- videos from the trips (owner's client 27.10: «полистать видосики с предыдущих выездов») -->
    <section class="sec wrap" id="media" data-chapter="media" aria-labelledby="h-media">
      <SectionHead id="h-media" title="Видео с наших поездок" lead="Листайте вбок: так выглядит Сеул, который мы показываем." />
      <div class="sec__body">
        <MediaCarousel clips={clips} label="Видео с поездок" />
      </div>
    </section>

    <!-- free: before the trip -->
    <section class="sec sec--tone" id="prepare" data-chapter="prepare" aria-labelledby="h-prepare">
      <div class="wrap">
        <SectionHead id="h-prepare" title={c.prepare.title} lead={c.prepare.lead}>
          <Note slot="note" mark="underline" rotate={-3}>бесплатно, без регистрации</Note>
        </SectionHead>
        <div class="prepare">
          <ul class="topics" role="list">
            {
              c.prepare.topics.map((tp) => (
                <li>
                  <a href={`/prepare/#${tp.id}`}>{nb(tp.title)}</a>
                </li>
              ))
            }
          </ul>
          <div class="prepare__map">
            <h3 class="t-name">{c.prepare.map_title}</h3>
            <p class="t-small prepare__maplead">{nb(c.prepare.map_lead)}</p>
            <InkMap districts={c.prepare.districts} />
          </div>
        </div>
        <LinkArrow href="/prepare/" class="prepare__more">Читать перед поездкой</LinkArrow>
      </div>
    </section>

    <!-- the founders: the client's own text and photos (29.10), verbatim -->
    <section class="sec wrap" id="authors" data-chapter="authors" aria-labelledby="h-authors">
      <div class="authors">
        <div class="authors__head">
          <h2 class="t-head" id="h-authors">{c.authors.title}</h2>
          <p class="t-lead">{nb(c.authors.lead)}</p>
          <p class="authors__intro">{nb(c.authors.intro)}</p>
          <div class="authors__group">
            <Photo slot="founders" ratio="4 / 5" alt="KOREA HAUS вечером в Сеуле" sizes="(min-width: 1024px) 36vw, 92vw" />
          </div>
        </div>
        <ul class="people" role="list">
          {
            c.authors.people.map((p) => (
              <li class="person">
                {p.slot && (
                  <div class="person__img">
                    <Photo slot={p.slot} ratio="4 / 5" alt={p.name} sizes="(min-width: 1024px) 160px, 34vw" />
                  </div>
                )}
                <div class="person__body">
                  <p class="t-name">{p.name}</p>
                  <p class="person__role">{p.role}</p>
                  <p class="person__text">{nb(p.text)}</p>
                </div>
              </li>
            ))
          }
          <li class="authors__close">
            <p>{nb(c.authors.closing)}</p>
            <div class="authors__sign">
              <Seal size={72} />
              <Note rotate={-3}>{c.authors.roles}</Note>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- how to buy -->
    <section class="sec sec--tone" id="buy" data-chapter="buy" aria-labelledby="h-buy">
      <div class="wrap buy">
        <SectionHead id="h-buy" title={c.buy.title} />
        <ol class="steps">
          {
            c.buy.steps.map((s) => (
              <li>
                <span class="t-name">{s.title}</span>
                <span class="steps__text">{nb(s.text)}</span>
              </li>
            ))
          }
        </ol>
        <div class="buy__cta">
          <div data-pick-empty>
            <ButtonPrimary href="#guides" note="Отметьте «+» нужные гайды - сообщение соберётся само">Выбрать гайды</ButtonPrimary>
          </div>
          <div data-pick-has hidden>
            <ButtonPrimary href="#contacts" data-pick-wa data-lead="guide" data-lead-slug="pick" note="Оплата из России, Казахстана и других стран">
              Написать в WhatsApp · <span data-pick-label>0 гайдов</span>
            </ButtonPrimary>
            <a class="buy__pick" href="/pick/">Посмотреть подборку</a>
          </div>
        </div>
        <div class="buy__faq">
          <h3 class="t-name">Вопросы</h3>
          <FAQ items={c.buy.faq} />
        </div>
      </div>
    </section>
  </main>

  <Footer note={c.footer.note} legal={c.footer.legal} />
</Base>

<script>
  // «В Сеуле сейчас …»: the page knows Seoul time (raise from the rain-night challenger); no JS → no line
  function seoulClock() {
    const box = document.querySelector<HTMLElement>('[data-seoul-clock]');
    const time = document.querySelector<HTMLElement>('[data-seoul-time]');
    const night = document.querySelector<HTMLElement>('[data-seoul-night]');
    if (!box || !time || !night) return;
    const now = new Date();
    time.textContent = new Intl.DateTimeFormat('ru-RU', { timeZone: 'Asia/Seoul', hour: '2-digit', minute: '2-digit' }).format(now);
    const h = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Seoul', hour: '2-digit', hourCycle: 'h23' }).format(now));
    night.hidden = !(h >= 21 || h < 4);
    box.hidden = false;
  }
  document.addEventListener('astro:page-load', seoulClock);
</script>

<style>
  .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 60;
    padding: 12px 16px;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }

  /* --- cover --- */
  .cover {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: clip;
    color: var(--on-photo);
    background: #2a2824;
  }

  .cover__media {
    position: absolute;
    inset: 0;
  }

  /* the client's frame (28.10) has «SEOUL» and four figures in it: it stands whole on top,
     the words go under it on the same dark ground instead of over the picture (phones 4:5, desktop 16:9) */
  @media all {
    .cover {
      display: block;
      min-height: 0;
      background: #1d1c1a;
    }

    .cover__media {
      position: relative;
      inset: auto;
      aspect-ratio: 9 / 16;
    }

    .cover__media::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 30%;
      background: linear-gradient(transparent, #1d1c1a);
    }

    .cover__scrim {
      display: none;
    }

    /* owner 29.10: the photo (extended down to 9:16, D-050) runs under the whole block,
       the title starts high so the walking figures stay right behind its last lines */
    .cover__text {
      margin-top: calc(210px - 177.78vw);
      padding-top: 0;
    }

    .cover__title {
      text-shadow: 0 1px 18px rgb(0 0 0 / 0.45);
    }
  }

  @media (min-width: 1024px) {
    .cover__media {
      aspect-ratio: 16 / 9;
      max-height: 100svh;
      width: 100%;
    }

    .cover__text {
      margin-top: -16px;
    }

    .cover__media::after {
      height: 22%;
      background: linear-gradient(transparent, #1d1c1a);
    }
  }

  .cover__scrim {
    position: absolute;
    inset: auto 0 0;
    height: 70%;
    background: linear-gradient(transparent, rgb(10 10 8 / 0.55));
    pointer-events: none;
  }

  .cover__text {
    position: relative;
    padding-bottom: calc(28px + env(safe-area-inset-bottom));
  }

  .cover__title {
    max-width: 16ch;
  }

  /* --- about: the client's words --- */
  .about {
    display: grid;
    gap: 16px;
  }

  .about__lead {
    max-width: 34ch;
    font-family: var(--f-display);
  }

  .about__text {
    display: grid;
    gap: 12px;
    max-width: 60ch;
    color: var(--ink-2);
  }

  :global(.about__hand) {
    justify-self: start;
  }

  /* the client's Seoul photos: a sideways strip under her words */
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(52vw, 220px);
    gap: 10px;
    margin: 8px calc(var(--gutter) * -1) 0;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .strip li {
    scroll-snap-align: start;
  }

  .strip :global(.photo) {
    border-radius: var(--r-l);
  }

  .cover__lead {
    max-width: 30ch;
    margin-top: 24px;
    font-size: var(--s-body);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.92);
  }

  .cover__act {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    margin-top: 10px;
  }

  /* six guides as round pebbles on the cover (3 × 2 on phones, one row on desktop) */
  .pebbles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 18px;
  }

  .pebble {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 12px;
    border-radius: var(--r-pill);
    background: rgb(246 242 234 / 0.95);
    color: var(--ink);
    font-size: 0.8125rem;
    line-height: 1.1;
    transition:
      transform 200ms var(--ease-tea),
      background-color var(--d-quick) var(--ease-tea);
  }

  .pebble:active {
    transform: scale(0.96);
  }

  .pebble--soon {
    background: rgb(246 242 234 / 0.68);
  }

  .pebble__ko {
    flex: none;
    font-family: var(--f-ko);
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--patch);
  }

  .cover__go {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }


  .cover__free {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: rgb(255 255 255 / 0.92);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }

  /* C1: the frame develops, then the title, then the rest - CSS only, no wait for JS */
  :global(.js-motion) .cover__media {
    animation: develop 900ms var(--ease-tea) both;
  }

  /* the title (the LCP) stands still from its first paint; the frame and the rest move around it */

  :global(.js-motion) .cover__lead,
  :global(.js-motion) .cover__act {
    animation: rise 700ms var(--ease-tea) 700ms both;
  }

  @keyframes develop {
    from {
      opacity: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* --- sections --- */
  .sec {
    padding-block: var(--section) 0;
  }

  .sec--tone {
    margin-top: calc(var(--section) * 0.75);
    padding-block: calc(var(--section) * 0.85);
    background: var(--plaster-2);
  }

  .sec--tone + .sec {
    padding-top: var(--section);
  }

  .sec__body {
    margin-top: 24px;
  }

  .inside__card {
    margin-top: 28px;
  }

  /* --- night: neon --- */
  .night {
    --amber: #ffb547;
    --teal: #4ff0d8;
    margin-top: calc(var(--section) * 0.75);
    background: #0b0b0a;
    color: #f4efe6;
  }

  .sec--tone + .night {
    margin-top: 0;
  }

  .night__frame {
    position: relative;
  }

  .night__frame :global(.photo) {
    border-radius: 0;
  }

  .night__over {
    position: absolute;
    inset: auto 0 0;
    padding-block: 120px 22px;
    background: linear-gradient(transparent, rgb(11 11 10 / 0.92) 70%);
  }

  .night__title {
    display: grid;
    gap: 0;
    font-weight: 400;
  }

  .night__seoul {
    color: #fff;
  }

  /* a neon tube word: white-hot core, amber glow on a separate layer whose opacity hums */
  .neon {
    position: relative;
    justify-self: start;
    margin-top: -0.12em;
    font-family: var(--f-hand);
    font-size: clamp(3.25rem, 2.4rem + 4vw, 6.5rem);
    font-weight: 500;
    line-height: 0.95;
    color: #fff4dc;
    text-shadow:
      0 0 2px #fff,
      0 0 6px var(--amber);
    transform: rotate(-4deg);
  }

  .neon::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: transparent;
    text-shadow:
      0 0 14px var(--amber),
      0 0 32px var(--amber),
      0 0 64px rgb(255 140 0 / 0.7);
    pointer-events: none;
  }

  .tube {
    display: block;
    width: min(100%, 420px);
    height: 40px;
    margin-top: 6px;
    overflow: visible;
  }

  .tube path {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .tube__core {
    stroke: #e8fffb;
    stroke-width: 2.5;
  }

  .tube__glow {
    stroke: var(--teal);
    stroke-width: 9;
    opacity: 0.5;
    filter: blur(5px);
  }

  .night__clock {
    margin-top: 10px;
    font-size: var(--s-small);
    color: #c9c1b4;
  }

  .night__clock b {
    font-weight: 500;
    color: var(--teal);
  }

  .night__body {
    padding-block: 26px calc(var(--section) * 0.85);
  }

  .night__lead {
    color: #f4efe6;
  }

  /* a teal rail with one light running along it */
  .rail {
    position: relative;
    display: block;
    height: 2px;
    margin-top: 26px;
    border-radius: 2px;
    background: rgb(79 240 216 / 0.35);
    box-shadow: 0 0 10px rgb(79 240 216 / 0.45); /* stylelint-disable-line declaration-property-value-disallowed-list -- neon tube glow, owner 27.10 */
    overflow: hidden;
  }

  .rail i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 22%;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, #e8fffb, transparent);
    animation: run 3.6s linear infinite;
  }

  @keyframes run {
    from {
      transform: translateX(-100%);
    }

    to {
      transform: translateX(460%);
    }
  }

  .night__list {
    display: grid;
    gap: 10px;
    margin-top: 26px;
  }

  .night__list a {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    align-items: center;
    gap: 14px;
    min-height: 76px;
    padding: 16px 18px;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(79 240 216 / 0.28);
    border-radius: var(--r-m);
    transition:
      border-color var(--d-base) var(--ease-tea),
      background-color var(--d-base) var(--ease-tea);
  }

  .night__list a:hover,
  .night__list a:focus-visible {
    border-color: var(--teal);
    background: rgb(79 240 216 / 0.08);
  }

  .night__emblem {
    font-size: 2.25rem;
    color: var(--amber);
    text-shadow: 0 0 12px rgb(255 181 71 / 0.6);
  }

  .night__list .t-name {
    color: #fff;
  }

  .night__text {
    display: block;
    margin-top: 4px;
    font-size: var(--s-small);
    color: #c9c1b4;
  }

  /* motion: the tube draws and the word flickers on once (motion/notes.ts sets data-lit), then hums */
  :global(.js-motion) .tube:not([data-lit]) path {
    stroke-dashoffset: 1;
  }

  .tube[data-lit] path {
    transition: stroke-dashoffset 1400ms var(--ease-tea);
  }

  :global(.js-motion) .neon:not([data-lit]) {
    opacity: 0.12;
  }

  :global(.js-motion) .neon:not([data-lit])::after {
    opacity: 0;
  }

  .neon[data-lit] {
    animation: flicker 1.3s steps(1, end) both;
  }

  .neon[data-lit]::after {
    animation:
      flicker 1.3s steps(1, end) both,
      hum 3.2s ease-in-out 1.3s infinite alternate;
  }

  @keyframes flicker {
    0% {
      opacity: 0.12;
    }

    12% {
      opacity: 1;
    }

    18% {
      opacity: 0.25;
    }

    30% {
      opacity: 1;
    }

    36% {
      opacity: 0.4;
    }

    48%,
    100% {
      opacity: 1;
    }
  }

  @keyframes hum {
    from {
      opacity: 1;
    }

    to {
      opacity: 0.72;
    }
  }

  :global(.js-motion) .night__list:not([data-lit]) li {
    opacity: 0;
    transform: translateY(14px);
  }

  .night__list[data-lit] li {
    transition:
      opacity 600ms var(--ease-tea) calc(400ms + var(--i) * 140ms),
      transform 600ms var(--ease-tea) calc(400ms + var(--i) * 140ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail i,
    .neon[data-lit],
    .neon[data-lit]::after {
      animation: none;
    }
  }

  /* --- tour: limited edition --- */
  .tour {
    display: grid;
    gap: 0;
  }

  .tour__print {
    padding: 10px;
    background: var(--paper);
    border-radius: var(--r-l);
  }

  .tour__label {
    position: relative;
    margin: -48px 14px 0;
    padding: 22px 18px 20px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-l);
  }

  .tour__kicker {
    font-size: var(--s-small);
    color: var(--p-tour);
  }

  .tour__title {
    margin-top: 10px;
  }

  .tour__sub {
    margin-top: 8px;
    font-family: var(--f-display);
    font-size: var(--s-lead);
  }

  .tour__rows {
    display: grid;
    gap: 10px;
    margin: 20px 0 14px;
    font-size: var(--s-small);
  }

  .tour__rows div {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 10px;
  }

  .tour__rows dt {
    color: var(--ink-2);
  }

  .tour__rows dd {
    line-height: 1.45;
  }

  /* --- prepare --- */
  .prepare {
    display: grid;
    gap: 32px;
    margin-top: 24px;
  }

  .topics {
    display: grid;
    gap: 6px;
  }

  .topics a {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 12px 18px;
    background: var(--paper);
    border-radius: var(--r-m);
    font-size: var(--s-body);
    transition: transform 240ms var(--ease-tea);
  }

  .topics a:active {
    transform: scale(0.985);
  }

  .prepare__maplead {
    margin: 8px 0 18px;
  }

  :global(.prepare__more) {
    margin-top: 28px;
  }

  /* --- authors --- */
  .authors {
    display: grid;
    gap: 28px;
  }

  .authors__head .t-lead {
    margin-top: 14px;
  }

  .authors__intro {
    margin-top: 12px;
    max-width: 60ch;
    color: var(--ink-2);
  }

  .authors__group {
    margin-top: 20px;
  }

  .authors__group :global(.photo),
  .person__img :global(.photo) {
    border-radius: var(--r-l);
  }

  .people {
    display: grid;
    gap: 10px;
  }

  .person {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 14px;
    align-items: start;
    padding: 10px 14px 14px 10px;
    border-radius: var(--r-l);
    background: var(--paper);
  }

  .person__img :global(.photo) {
    border-radius: var(--r-m);
  }

  .person:not(:has(.person__img)) {
    grid-template-columns: 1fr;
    padding-left: 16px;
  }

  .person__role {
    margin-top: 2px;
    font-size: 0.8125rem;
    color: var(--hand);
  }

  .person__text {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .authors__close {
    padding: 8px 4px 0;
    font-family: var(--f-display);
    font-size: var(--s-lead);
    line-height: 1.3;
  }

  .authors__sign {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 14px;
    font-family: var(--f-text);
  }

  /* --- buy --- */
  .steps {
    display: grid;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    gap: 6px;
    padding: 18px 20px 20px;
    background: var(--paper);
    border-radius: var(--r-m);
  }

  .steps__text {
    font-size: var(--s-body);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .buy__cta {
    margin-block: 32px 0;
  }

  .buy__pick {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 6px;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .buy__faq {
    margin-top: 44px;
  }

  .buy__faq .t-name {
    margin-bottom: 14px;
  }

  /* --- desktop: the store at full width --- */
  @media (min-width: 1024px) {
    .cover__text {
      padding-bottom: 72px;
    }

    .cover__title {
      max-width: 18ch;
    }

    .about {
      grid-template-columns: 5fr 7fr;
      column-gap: 64px;
      align-items: start;
    }

    .about__title {
      grid-row: span 3;
    }

    .strip {
      grid-column: 1 / -1;
      grid-auto-columns: 240px;
      gap: 16px;
      margin-inline: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
    }

    .pebbles {
      grid-template-columns: repeat(6, auto);
      justify-content: start;
    }

    .pebble {
      padding: 0 18px;
      font-size: 0.9375rem;
    }

    .inside {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }

    .inside :global(.sh) {
      grid-template-columns: 1fr;
      position: sticky;
      top: calc(var(--bar-h) + 40px);
    }

    .inside__card {
      margin-top: 0;
    }

    .night__over {
      padding-bottom: 56px;
    }

    .night__body {
      display: grid;
      grid-template-columns: 7fr 5fr;
      gap: 0 64px;
      align-items: start;
    }

    .night__body .rail {
      grid-column: 1;
    }

    .night__list {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0;
    }

    .tour {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }

    .tour__label {
      margin: 0 0 64px -96px;
      padding: 32px 32px 28px;
    }

    .prepare {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }

    .authors {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }

    .person {
      grid-template-columns: 160px 1fr;
      gap: 20px;
    }

    .buy {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 0 64px;
    }

    .buy > :global(*) {
      grid-column: 2;
    }

    .buy > :global(.sh) {
      grid-column: 1;
      grid-row: 1 / span 4;
      align-self: start;
    }

    .steps {
      grid-template-columns: repeat(3, 1fr);
      margin-top: 0;
    }
  }
</style>
