{
  "name": "seoul-guides-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-public.mjs && astro build && node scripts/rebase.mjs && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "astro check && eslint . && stylelint \"src/**/*.{css,astro}\"",
    "format": "prettier --write .",
    "shots": "playwright test --project=shots",
    "test:e2e": "playwright test --project=e2e",
    "trace": "playwright test --project=trace",
    "perf": "lhci autorun --config=../qa/lighthouserc.cjs",
    "slop": "impeccable detect src",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@preact/signals": "2.11.3",
    "astro": "7.4.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "impeccable": "4.8.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
